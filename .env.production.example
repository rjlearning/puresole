# ─── PureSoul Production Environment ──────────────────────────────────────────
# Copy this file to .env.production and fill in your real values.
# Railway will inject these as environment variables automatically.

# ── Backend URL (REQUIRED for mobile app) ────────────────────────────────────
# This is the public HTTPS URL of your deployed backend.
# Example: https://puresoul-production.up.railway.app
VITE_API_BASE_URL=https://YOUR_BACKEND_URL_HERE

# ── WebSocket URL ─────────────────────────────────────────────────────────────
VITE_WS_URL=wss://YOUR_BACKEND_URL_HERE

# ── Server-side env vars (set in Railway dashboard, NOT here) ─────────────────
# DATABASE_URL=postgresql://...
# OPENAI_API_KEY=sk-...
# SESSION_SECRET=...
# AUDIO_ENCRYPTION_KEY=...
# REDIS_URL=redis://...
