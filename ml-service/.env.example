# ML Service Configuration

# Server
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost/puresoul

# Redis (for job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OpenAI API (for Whisper transcription)
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=  # Leave empty for auto-detect, or set to ISO-639-1 code (e.g., en, es, fr)
WHISPER_TEMPERATURE=0

# File Storage
AUDIO_STORAGE_PATH=/tmp/puresoul/audio
MAX_AUDIO_FILE_SIZE_MB=50

# Model Configuration
EMOTION_MODEL_PATH=./models/emotion_classifier.h5
SENTIMENT_MODEL_PATH=./models/sentiment_analyzer

# Processing
MAX_CONCURRENT_JOBS=4
ANALYSIS_TIMEOUT_SECONDS=300

# Feature Extraction
SAMPLE_RATE=16000
MFCC_COEFFICIENTS=13
FFT_SIZE=2048
HOP_LENGTH=512

# Security
API_KEY_HEADER=X-API-Key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/ml-service.log
