# MindMender - Docker Ignore File
# Exclude files from Docker build context

# Dependencies
node_modules
npm-debug.log
yarn-error.log

# Build outputs
dist
build
.next
.output

# Development files
.env
.env.local
.env.development
.env.test
.env.production.local

# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Documentation
*.md
!README.md
docs
PHASE*.md
UI_IMPROVEMENTS*.md
QUICK_START*.md
STARTUP*.md

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
__tests__
coverage
.nyc_output

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp
temp
*.tmp
.cache

# OS files
Thumbs.db
.DS_Store

# Docker files (don't include in build)
docker-compose*.yml
Dockerfile*
.dockerignore

# Scripts
scripts/*.cjs
scripts/*.js

# Exports (will be mounted as volume)
server/exports/*

# Uploads (will be mounted as volume)
uploads/*
